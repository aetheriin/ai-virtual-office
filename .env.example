# === AI providers (free tiers) ===
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Model per role (override freely; free model IDs on OpenRouter change often)
MODEL_PM=google/gemma-3-27b-it:free
MODEL_RISK=google/gemma-3-27b-it:free
MODEL_CODER=qwen/qwen-2.5-coder-32b-instruct:free
MODEL_DEBATE=meta-llama/llama-3.1-8b-instruct:free
# If set, PM & Risk agents call Google AI Studio directly with this model instead of OpenRouter
GEMINI_MODEL=gemini-2.5-flash

# === Market data ===
TWELVE_DATA_API_KEY=

# === News sentiment (all optional; RSS works without a key) ===
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_RSS_FEEDS=https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news_1.rss
NEWS_LOOKBACK_HOURS=24
# Let the debate model rescore headlines (falls back to keyword lexicon)
NEWS_USE_LLM=true
ENABLE_NEWS=true
# Invent candles when no live source answers (demo only, never trade on it).
# Keep false: a mistyped ticker then gives a clear "not found" error.
ALLOW_SYNTHETIC_DATA=false
# MetaTrader5 broker symbol names (auto-detected if empty), e.g. {"XAUUSD":"XAUUSDm"} or suffix "m"
MT5_SYMBOL_MAP=
MT5_SYMBOL_SUFFIX=

# === Risk defaults ===
DEFAULT_CAPITAL=10000000
DEFAULT_RISK_PCT=1.0
MIN_RR=1.5
# TP1 (nearest resistance) must be at least this many R away
MIN_RR_TP1=1.0
MAX_DAILY_LOSS_PCT=3.0

# === Server ===
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
SQLITE_PATH=office.db

# === PostgreSQL (IT projects, sprints, tasks, code, QA findings) ===
# docker compose up -d  ->  postgresql://office:office@localhost:5432/office
# Leave empty to use a local SQLite file (backend/projects.db) instead.
DATABASE_URL=postgresql://office:office@localhost:5432/office
POSTGRES_USER=office
POSTGRES_PASSWORD=office
POSTGRES_DB=office
# Run Alembic migrations automatically on startup
DB_AUTO_MIGRATE=true

# === GitHub pull requests from the IT department ===
# Fine-grained token: Repository access = only the repos you connect;
# permissions: Contents (read/write), Pull requests (read/write), Metadata (read), Issues (read/write, optional: label)
GITHUB_TOKEN=
AUTO_PR=true
# Without an LLM the coders produce generic templates; keep false so they are never pushed to real repos
ALLOW_TEMPLATE_PR=false
PR_BRANCH_PREFIX=ai/
PR_MAX_FILES=40
PR_MAX_FILE_KB=200

# === IDX rules & liquidity (stocks) ===
# ARA/ARB defaults follow BEI Oct 2026 (ARA 35/25/20%, ARB 7%, symmetric from 2027); override in percent
IDX_ARA_PCT=
IDX_ARB_PCT=
# Average daily traded value below this vetoes a stock; below WARN only warns
MIN_DAILY_VALUE_IDR=1000000000
WARN_DAILY_VALUE_IDR=5000000000

# === Paper-trading journal & screener ===
JOURNAL_REFRESH_MIN=15
JOURNAL_EXPIRY_HOURS=48
JOURNAL_EXPIRY_DAYS=10
# Best N screener picks recorded in the journal per scan
SCREENER_JOURNAL_TOP=3
