# === AI providers (free tiers) ===
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Model per role (override freely; free model IDs on OpenRouter change often)
MODEL_PM=google/gemma-3-27b-it:free
MODEL_RISK=google/gemma-3-27b-it:free
MODEL_CODER=qwen/qwen-2.5-coder-32b-instruct:free
MODEL_DEBATE=meta-llama/llama-3.1-8b-instruct:free
# If set, PM & Risk agents call Google AI Studio directly with this model instead of OpenRouter
GEMINI_MODEL=gemini-2.5-flash

# === Market data ===
TWELVE_DATA_API_KEY=

# === News sentiment (all optional; RSS works without a key) ===
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_RSS_FEEDS=https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news_1.rss
NEWS_LOOKBACK_HOURS=24
# Let the debate model rescore headlines (falls back to keyword lexicon)
NEWS_USE_LLM=true
ENABLE_NEWS=true
# Allow synthetic candles when no live source is reachable (demo only, never trade on it)
ALLOW_SYNTHETIC_DATA=true

# === Risk defaults ===
DEFAULT_CAPITAL=10000000
DEFAULT_RISK_PCT=1.0
MIN_RR=1.5
MAX_DAILY_LOSS_PCT=3.0

# === Server ===
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
SQLITE_PATH=office.db

# === PostgreSQL (IT projects, sprints, tasks, code, QA findings) ===
# docker compose up -d  ->  postgresql://office:office@localhost:5432/office
# Leave empty to use a local SQLite file (backend/projects.db) instead.
DATABASE_URL=postgresql://office:office@localhost:5432/office
POSTGRES_USER=office
POSTGRES_PASSWORD=office
POSTGRES_DB=office
# Run Alembic migrations automatically on startup
DB_AUTO_MIGRATE=true
